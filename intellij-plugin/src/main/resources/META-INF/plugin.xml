<!-- Installed, updated and removed with an IDE restart: the plugin keeps caches on PSI files and its views,
     which an update in place could leave behind. -->
<idea-plugin require-restart="true">
    <id>cc.gahaha.fastmultiversion</id>
    <name>FastMultiversion</name>
    <vendor>gahaha</vendor>
    <description><![CDATA[
    Support for Minecraft mods built for several Minecraft versions from one source tree with
    <code>Mc.is("range")</code> and <code>@IfMc("range")</code>:
    <ul>
      <li>reports, as you type, Minecraft API used in code that also runs in versions without it,
          with quick fixes to guard it;</li>
      <li>resolves code that does not run in the active Minecraft version against the version it runs in:
          its errors, Go to Declaration, Quick Documentation and member completion use that version's
          Minecraft, not the active one's;</li>
      <li>creates new mod projects: File → New → Project → Generators → FastMultiversion.</li>
    </ul>
    Needs the multiversion Gradle plugin, which writes build/multiversion/project.properties and the API
    database (task <code>generateApiDatabase</code>, which the plugin runs after each Gradle sync).
    ]]></description>

    <depends>com.intellij.modules.java</depends>
    <depends>com.intellij.gradle</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- File → New → Project → Generators → FastMultiversion. -->
        <moduleBuilder builderClass="cc.gahaha.fastmultiversion.intellij.wizard.FastMultiversionModuleBuilder"/>
        <notificationGroup id="FastMultiversion" displayType="BALLOON"/>
        <!-- Updates: the plugin's own repository on GitHub Pages. -->
        <postStartupActivity implementation="cc.gahaha.fastmultiversion.intellij.update.PluginRepositoryRegistrar"/>

        <localInspection language="JAVA"
                         shortName="McApiRange"
                         displayName="Minecraft API used outside the versions that have it"
                         groupName="FastMultiversion"
                         enabledByDefault="true"
                         level="ERROR"
                         implementationClass="cc.gahaha.fastmultiversion.intellij.McApiRangeInspection"/>
        <daemon.highlightInfoFilter implementation="cc.gahaha.fastmultiversion.intellij.InactiveCodeHighlightFilter"/>
        <annotator language="JAVA" implementationClass="cc.gahaha.fastmultiversion.intellij.InactiveNamesAnnotator"/>

        <!-- Code that does not run in the active version, resolved in a view of the version it runs in. -->
        <resolveScopeProvider order="first" implementation="cc.gahaha.fastmultiversion.intellij.VersionViewResolveScopeProvider"/>
        <gotoDeclarationHandler order="first" implementation="cc.gahaha.fastmultiversion.intellij.InactiveGotoDeclarationHandler"/>
        <lang.documentationProvider language="JAVA" order="first"
                                    implementationClass="cc.gahaha.fastmultiversion.intellij.InactiveDocumentationProvider"/>
        <completion.contributor language="JAVA" order="first"
                                implementationClass="cc.gahaha.fastmultiversion.intellij.InactiveCompletionContributor"/>
        <completion.contributor language="JAVA" order="first"
                                implementationClass="cc.gahaha.fastmultiversion.intellij.RangeCompletionContributor"/>
    </extensions>

    <projectListeners>
        <!-- After a Gradle sync: generateApiDatabase, then code of other versions is checked again. -->
        <listener class="cc.gahaha.fastmultiversion.intellij.GradleSyncListener"
                  topic="com.intellij.openapi.externalSystem.service.project.manage.ProjectDataImportListener"/>
    </projectListeners>
</idea-plugin>
