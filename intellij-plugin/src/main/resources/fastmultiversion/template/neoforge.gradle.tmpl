// The build script of every {{projects}} project; multiversion.version is that project's Minecraft version.
apply plugin: 'net.neoforged.moddev'

def mc = multiversion.version
def dep = { String key -> project.property("mc.${mc}.${key}") }

group = maven_group
version = "${mod_version}-${mc}"
base {
    archivesName = "${archives_name}-neoforge"
}

java {
    toolchain.languageVersion = JavaLanguageVersion.of(java_version)
}

tasks.withType(JavaCompile).configureEach {
    options.release = java_version as int
}

repositories {
    maven { url = "https://maven.neoforged.net/releases" }
}

neoForge {
    version = dep('neoforge')
    runs {
        // A run configuration per version, e.g. "NeoForge Client 26.3".
        configureEach {
            ideName = "NeoForge ${it.name.capitalize()} ${mc}"
        }
        client {
            client()
            gameDirectory = file('runs/client')
        }
        server {
            server()
            gameDirectory = file('runs/server')
        }
    }
    mods {
        "${mod_id}" {
            sourceSet sourceSets.main
        }
    }
}

processResources {
    def properties = [version: project.version, minecraft_version_range: dep('range_neoforge')]
    inputs.properties(properties)
    filesMatching('META-INF/neoforge.mods.toml') {
        expand(properties)
    }
}
