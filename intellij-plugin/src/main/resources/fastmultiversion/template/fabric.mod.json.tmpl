{
    "schemaVersion": 1,
    "id": "{{modId}}",
    "version": "${version}",
    "name": {{modNameJson}},
    "description": {{descriptionJson}},
    "authors": {{authorsJson}},
{{contactEntry}}    "license": "{{licenseId}}",
    "environment": "*",
{{accessWidenerEntry}}    "entrypoints": {
        "main": [
            "{{fabricEntrypoint}}"
        ]
    },
    "mixins": [
        "{{modId}}.mixins.json"
    ],
    "depends": {
        "fabricloader": "*",
        "minecraft": "${minecraft_version_range}",
        "java": ">=25",
        "fabric-api": "*"
    }
}
