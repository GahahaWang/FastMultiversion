// The build script of every :<version>:common project: the shared code in src/main, compiled against Minecraft
// without a loader. In the IDE it owns src/main, so each loader's code sees the shared code but not the others'.
apply plugin: 'net.fabricmc.fabric-loom'

java {
    toolchain.languageVersion = JavaLanguageVersion.of(java_version)
}

tasks.withType(JavaCompile).configureEach {
    options.release = java_version as int
}

loom {
    // The access changes of src/main/resources, with this version's lines, as an access widener: what FastMultiversion
    // sets anyway, written down.
    accessWidenerPath = multiversion.accessWidener
    runs {
        configureEach {
            ideConfigGenerated(false)
        }
    }
}

dependencies {
    minecraft "net.minecraft:minecraft:${multiversion.version}"
    // Mixin for the shared code's mixins; at run time each loader brings its own.
    compileOnly "net.fabricmc:sponge-mixin:${mixin_version}"
    compileOnly "io.github.llamalad7:mixinextras-common:${mixinextras_version}"
}
